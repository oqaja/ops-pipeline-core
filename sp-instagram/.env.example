# Salin file ini jadi .env buat testing LOKAL (di laptop). JANGAN commit
# file .env ke git (sudah ada di .gitignore). Di GitHub Actions, value-value
# ini datang dari GitHub Secrets, bukan file ini.

# Isi PERSIS 1 baris seluruh isi file JSON key service account (lihat README.md).
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}

# Access token Instagram Graph API (yang sama seperti yang dulu disimpan
# di Script Properties Apps Script sebagai SP_IG_ACCESS_TOKEN).
SP_IG_ACCESS_TOKEN=

# Opsional - API key Google Cloud buat bikin direct-download link Drive
# yang aman untuk file besar (sama seperti versi Apps Script). Kalau kosong,
# fallback ke link lama (bisa gagal untuk file besar).
GOOGLE_DRIVE_API_KEY=

# --- ID resource (di GitHub Actions ini dari repo Variables, bukan Secrets) ---
KALENDER_SPREADSHEET_ID=
INSIGHTS_SPREADSHEET_ID=
DRIVE_FOLDER_ID=
DOCS_MASTER_ID=
SP_IG_BUSINESS_ACCOUNT_ID=
