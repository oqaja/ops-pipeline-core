GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
GOOGLE_DRIVE_API_KEY=

# --- OAuth YouTube ---
# Ambil dari: Google Cloud Console > project AFFILIATE-AUTOMATION > APIs & Services
#   > Credentials > OAuth 2.0 Client ID
# Client Secret cuma bisa dilihat SEKALI pas di-generate — kalau ilang, klik
#   "Add Secret" buat generate baru (secret lama tetep valid, gak perlu dihapus).
# Pastikan "http://localhost:8080" ada di Authorized redirect URIs client ini.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# Consent screen masih status "Testing" -> refresh token expired tiap ~7 hari.
# Generate ulang tiap ~6 hari: `npm run regen-token` (lihat scripts/regen-refresh-token.js),
# lalu update secret SP_YT_REFRESH_TOKEN di GitHub.
YT_REFRESH_TOKEN=

# --- ID resource + template deskripsi (di GitHub Actions dari repo Variables) ---
KALENDER_SPREADSHEET_ID=
INSIGHTS_SPREADSHEET_ID=
DRIVE_FOLDER_ID=
DOCS_MASTER_ID=
CHANNEL_DESCRIPTION_TEMPLATE=
